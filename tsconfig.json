{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./vendor/web/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "browser/**/*.ts"
  ],
  "compileOnSave": false
}
